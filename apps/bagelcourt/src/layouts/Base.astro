---
import '@/styles/global.css';
import { typeClass } from '@/lib/type-scale';
import { fontWeights } from '@/lib/font-weight';

interface Props {
  title: string;
  description: string;
  /** Canonical path without a trailing slash, e.g. "/privacy". Omit for pages that shouldn't be indexed. */
  path?: string;
}

const { title, description, path } = Astro.props;
const canonical = path ? new URL(path, Astro.site).href : undefined;
const image = new URL('/brandmark.png', Astro.site).href;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/support', label: 'Support' },
  { href: '/privacy', label: 'Privacy Policy' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/brandmark.png" />
    <link rel="apple-touch-icon" href="/brandmark.png" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#F6F4EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0D0F" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BagelCourt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="256" />
    <meta property="og:image:height" content="256" />
    <meta property="og:image:alt" content="BagelCourt logo: a gold dot-matrix zero" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="mx-auto w-full max-w-xl px-5 pt-6">
      <a href="/" class="inline-flex min-h-11 items-center gap-3">
        <img src="/brandmark.png" alt="" width="32" height="32" class="rounded-lg" />
        <span class={typeClass('title')} style={`font-variation-settings: ${fontWeights.semibold}`}>BagelCourt</span>
      </a>
    </header>
    <main class="mx-auto w-full max-w-xl flex-1 px-5 py-10">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-xl px-5 pb-8">
      <nav aria-label="Site" class="flex flex-wrap gap-x-2 border-t pt-4">
        {nav.map((item) => (
          <a
            href={item.href}
            class={`inline-flex min-h-11 items-center px-1 text-muted-foreground transition-colors duration-80 hover:text-foreground ${typeClass('caption')}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </footer>
  </body>
</html>
