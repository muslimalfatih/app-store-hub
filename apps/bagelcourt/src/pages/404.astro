---
import Base from '@/layouts/Base.astro';
import { LinkButton } from '@/components/LinkButton';
---

{/* No path: the layout marks this page noindex and gives it no canonical URL. */}
<Base title="Page not found · BagelCourt" description="This page doesn't exist on the BagelCourt site.">
  <article class="typeset">
    <h1>Page not found</h1>
    <p>This page doesn't exist or has moved.</p>
  </article>
  <div class="mt-8">
    <LinkButton href="/" label="Go to the home page" />
  </div>
</Base>
