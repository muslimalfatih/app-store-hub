// Assets-only Worker on the Workers Free plan: no "main", no adapter, no run_worker_first.
// "name" must match the Worker name in the Cloudflare dashboard.
{
  "name": "bagelcourt",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  // Project-level opt-out of Wrangler usage telemetry. As of wrangler 4.147.0, `wrangler deploy`
  // autoconfig telemetry ignores this, so CI and Cloudflare builds also set WRANGLER_SEND_METRICS=false.
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
